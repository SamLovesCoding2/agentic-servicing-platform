# ── LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# For router classifier (cheaper model)
OPENAI_ROUTER_MODEL=gpt-4o-mini

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agentic_platform:agentic_platform@localhost:5432/agentic_platform

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Mock FAC API ─────────────────────────────────────────────────────────
FAC_API_BASE_URL=http://localhost:9000
FAC_API_TIMEOUT_SECONDS=10

# ── Mock Payment Provider ────────────────────────────────────────────────
PAYMENT_PROVIDER_BASE_URL=http://localhost:9001
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10

# ── Temporal (M2+) ───────────────────────────────────────────────────────
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=chargeoffs-v2

# ── Observability ────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-servicing-platform
OTEL_ENABLED=true

# ── Local object storage (M4 profile) ────────────────────────────────────
MINIO_ROOT_PASSWORD=change-me-in-development

# ── Agent Runtime ────────────────────────────────────────────────────────
MAX_MODEL_TURNS=10
MAX_TOOL_ATTEMPTS=5
MAX_TEXT_TURN_SECONDS=30
MAX_VOICE_TURN_SECONDS=15

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
